# Local demo uses SQLite in .data/. Never use children's information.
TRACELAB_DB_PATH=.data/tracelab.db
# Optional hosted PostgreSQL adapter; run pnpm db:migrate before enabling.
DATABASE_URL=
CLOUDFLARE_ACCOUNT_ID=
# Supply provider tokens through the deployment secret store, not this file.

# Explicit public origin for CSRF checks behind the Next.js reverse proxy.
TRACELAB_PUBLIC_ORIGIN=http://localhost:3000

# Optional Neon PostgreSQL. When set, migrate first; failures never fall back to SQLite.
# DATABASE_URL=postgresql://user:password@your-project.neon.tech/neondb?sslmode=require
