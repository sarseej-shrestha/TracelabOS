{
  "name": "tracelab-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.13.0 <23 || >=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "next dev apps/web --hostname 127.0.0.1",
    "build": "next build apps/web --webpack",
    "start": "next start apps/web --hostname 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "benchmark": "node --experimental-transform-types scripts/benchmark.ts",
    "oracle:vectors": "node --experimental-transform-types scripts/oracle-vectors.ts",
    "db:migrate": "node --experimental-transform-types scripts/migrate.ts",
    "db:import-sqlite": "node --experimental-transform-types scripts/import-sqlite.ts",
    "images:migrate": "node --experimental-transform-types scripts/images.ts migrate",
    "images:reconcile": "node --experimental-transform-types scripts/images.ts reconcile"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@neondatabase/serverless": "1.2.0",
    "hono": "4.13.13",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "fast-check": "4.8.0",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "pure-rand": "8.4.0",
      "sharp": "0.35.5"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
